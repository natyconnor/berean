<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the app and its helpers. Only what
  Electron itself needs: V8 compiles JavaScript at run time (JIT). The web
  app uses no camera, microphone, location or other device, and the shell
  denies every permission request, so nothing else is granted. No
  Associated Domains (no Universal Links).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
